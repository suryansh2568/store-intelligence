FROM python:3.10-slim

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

# Copy dashboard code
COPY dashboard/ ./dashboard/

# Expose port
EXPOSE 8501

# Run the dashboard (Render uses PORT env variable)
CMD streamlit run dashboard/streamlit_app.py --server.port=${PORT:-8501} --server.address=0.0.0.0
